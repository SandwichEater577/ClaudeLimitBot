{
  "hooks": {
    "StopFailure": [
      {
        "matcher": "rate_limit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/notify.py\" hook || python \"${CLAUDE_PLUGIN_ROOT}/scripts/notify.py\" hook",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/notify.py\" session || python \"${CLAUDE_PLUGIN_ROOT}/scripts/notify.py\" session",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
