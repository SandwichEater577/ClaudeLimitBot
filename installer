#!/usr/bin/env python3
"""ClaudeLimitBot installer, an interactive terminal app (standard library only).

    ./installer          Linux / macOS
    python installer     Windows

Arrow keys or j/k to move, Enter to choose, Esc to go back, Ctrl+C to quit.
"""
import getpass, json, os, re, shutil, subprocess, sys, threading, time
from pathlib import Path

HERE = Path(__file__).resolve().parent
NOTIFY = HERE / "scripts" / "notify.py"
SEALED = HERE / "sealed.json"
CFG = Path.home() / ".config/limit-bot/config.json"
REPO = "SandwichEater577/ClaudeLimitBot"
MKT, PLUGIN, VERSION = "claude-limit-bot", "limit-bot", "1.3.0"
TITLE, TAGLINE = "C L A U D E   L I M I T   B O T", "posts to Discord when you hit your limit"
sys.path.insert(0, str(HERE / "scripts"))

# ─── terminal ──────────────────────────────────────────────────────────────────

IS_WIN = os.name == "nt"
if IS_WIN:
    os.system("")  # turn on ANSI escape handling in Windows 10+ consoles
TTY = sys.stdin.isatty() and sys.stdout.isatty()
COLOR = sys.stdout.isatty() and "NO_COLOR" not in os.environ
ANSI = re.compile(r"\033\[[0-9;?]*[A-Za-z]")


def sgr(code):
    return lambda s: f"\033[{code}m{s}\033[0m" if COLOR else str(s)


ORANGE, PEACH, GREY = sgr("38;5;173"), sgr("38;5;216"), sgr("38;5;245")
FAINT, GREEN, RED = sgr("38;5;239"), sgr("38;5;114"), sgr("38;5;167")
BOLD, SELECTED = sgr("1"), sgr("48;5;173;38;5;234;1")
SPIN = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
FPS = 12
START = time.time()


class Cancel(Exception):
    """Esc pressed: leave the current screen."""


def vlen(s):
    """Visible width: colour codes take no space on screen."""
    return len(ANSI.sub("", s))


def pad(s, width, align="left"):
    gap = max(0, width - vlen(s))
    if align == "center":
        return " " * (gap // 2) + s + " " * (gap - gap // 2)
    return s + " " * gap if align == "left" else " " * gap + s


def screen_width():
    return max(46, min(74, shutil.get_terminal_size((80, 24)).columns - 4))


def screen_height():
    return shutil.get_terminal_size((80, 24)).lines


def spaced(text):
    return " ".join(text.upper())


def box(lines, width, title="", footer="", align="left", edge=FAINT, rows=0):
    """A rounded panel: title in the top-left border, footer in the bottom-right one.
    rows pads the body so panels end on the same line."""
    inner = width - 2
    lines = list(lines) + [""] * max(0, rows - len(lines))
    top = edge("╭" + "─" * inner + "╮")
    if title:
        label = f" {ORANGE('◆')} {ORANGE(BOLD(title))} "
        top = edge("╭─") + label + edge("─" * max(0, inner - 1 - vlen(label)) + "╮")
    bottom = edge("╰" + "─" * inner + "╯")
    if footer:
        label = f" {GREY(footer)} "
        bottom = edge("╰" + "─" * max(0, inner - 2 - vlen(label))) + label + edge("──╯")
    body = [edge("│") + "  " + pad(line, inner - 4, align) + "  " + edge("│") for line in lines]
    return [top, *body, bottom]


def mascot(busy=False, arms_up=False):
    """The Claude Code character, one animation frame (3 rows, 11 columns).
    Idle: blinks and waves now and then. Busy: walks in place and sways."""
    tick = int((time.time() - START) * 8)
    beat = tick % 48
    eyes = "▐█████▌" if beat in (20, 21) or beat == 36 else "▐▛███▜▌"
    waving = arms_up or (not busy and 30 <= beat < 36 and tick % 2 == 0)
    body = "▗▟█████▙▖" if waving else "▝▜█████▛▘"
    legs = "▝▝ ▘▘" if busy and (tick // 2) % 2 else "▘▘ ▝▝"
    shift = (0, 1, 2, 1)[(tick // 3) % 4] - 1 if busy else 0
    rows = [f" {eyes} ", body, f"  {legs}  "]
    return [" " * (1 + shift) + row + " " * (1 - shift) for row in rows]


def read_key(timeout=None):
    """One key press: 'up', 'down', 'left', 'right', 'enter', 'esc', 'backspace',
    or the character typed. With a timeout, None when no key arrives in time."""
    if IS_WIN:
        import msvcrt
        if timeout is not None:
            end = time.time() + timeout
            while not msvcrt.kbhit():
                if time.time() >= end:
                    return None
                time.sleep(0.01)
        ch = msvcrt.getwch()
        if ch in ("\x00", "\xe0"):
            return {"H": "up", "P": "down", "K": "left", "M": "right"}.get(msvcrt.getwch(), "")
    else:  # the terminal is already in key-by-key mode, see key_mode()
        import select
        fd = sys.stdin.fileno()
        if timeout is not None and not select.select([fd], [], [], timeout)[0]:
            return None
        raw = os.read(fd, 1)
        if raw == b"\x1b":
            seq = os.read(fd, 2) if select.select([fd], [], [], 0.03)[0] else b""
            return {b"[A": "up", b"[B": "down", b"[C": "right", b"[D": "left",
                    b"OA": "up", b"OB": "down", b"OC": "right", b"OD": "left"}.get(seq, "esc")
        if raw[0] >= 0xC0:  # first byte of a multi-byte character
            raw += os.read(fd, 1 if raw[0] < 0xE0 else 2 if raw[0] < 0xF0 else 3)
        ch = raw.decode(errors="ignore")
    if ch == "\x03":
        raise KeyboardInterrupt
    return {"\r": "enter", "\n": "enter", "\x7f": "backspace", "\x08": "backspace", "\x1b": "esc", "\t": "tab"}.get(ch, ch)


def key_mode():
    """Switch the terminal to key-by-key input with no echo, once for the whole run.
    Returns a function that puts it back. Ctrl+C still works (it raises KeyboardInterrupt)."""
    if IS_WIN or not TTY:
        return lambda: None
    import termios, tty
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    tty.setcbreak(fd)
    return lambda: termios.tcsetattr(fd, termios.TCSADRAIN, old)


# ─── work (the demo swaps these out) ───────────────────────────────────────────

def run(cmd):
    return subprocess.run(cmd, capture_output=True, text=True)


def unseal_secrets(password):
    """The password opens sealed.json: the channel webhook and the read-only bot token."""
    import vault
    text = vault.unseal(password, json.loads(SEALED.read_text()))
    return json.loads(text) if text.startswith("{") else {"webhook": text}


def find_member(token, username):
    """(user id, username, seat) for someone on the server, or None."""
    import notify
    return notify.find_member(token, username)


def outcome(result, success=""):
    """Turn a finished command into (ok, detail) for the progress panel."""
    text = (result.stdout + result.stderr).strip()
    if result.returncode == 0 or "already" in text.lower():
        return True, success
    return False, (text.splitlines() or ["failed"])[-1][:60]


def in_background(work, on_tick):
    """Run work() on a thread, calling on_tick(frame) until it finishes."""
    result = {}
    thread = threading.Thread(target=lambda: result.setdefault("r", work()), daemon=True)
    thread.start()
    tick = 0
    while thread.is_alive():
        on_tick(tick)
        tick += 1
        time.sleep(1 / FPS)
    return result.get("r")


# ─── the app ───────────────────────────────────────────────────────────────────

class App:
    def __init__(self):
        self.claude = shutil.which("claude")
        saved = json.loads(CFG.read_text()) if CFG.exists() else {}
        self.saved = saved
        self.secrets = {}
        self.selected = 0
        self.plan, self.form, self.log = [], [], []
        self.status = ""
        self.busy = False
        self.items = [
            ("Install", "add the plugin and save your settings", self.install),
            ("Update", "get the newest version", self.update),
            ("Uninstall", "remove the plugin and your settings", self.uninstall),
            ("Quit", "leave the installer", None),
        ]

    # ── drawing ──

    def hero(self, compact=False, lift=False, arms_up=False, title=TITLE, tagline=TAGLINE):
        w = screen_width()
        if compact:
            return box([BOLD(title)], w, footer=f"v{VERSION}", align="center", edge=ORANGE)
        art = [PEACH(row) for row in mascot(self.busy, arms_up)]
        art = [*art, "", ""] if lift else ["", *art, ""]
        return box([*art, BOLD(title), GREY(tagline), ""], w, footer=f"v{VERSION}", align="center", edge=ORANGE)

    def show(self, build, below=""):
        """Draw a screen in place. build(compact) returns its lines; short
        terminals get the compact hero. Every line is centred."""
        if not TTY:
            return
        lines = build(False)
        if len(lines) + 2 > screen_height():
            lines = build(True)
        w = screen_width()
        out = ["  " + pad(line, w, "center") + "\033[K" for line in lines]
        sys.stdout.write("\033[H" + "\n".join(out) + "\n\033[J" + below)
        sys.stdout.flush()

    def panels(self):
        w = screen_width()
        out = []
        if self.plan:
            out += box(self.plan, w, "THIS WILL")
        if self.form:
            out += box([f"{GREY(pad(k, 14))}{v}" for k, v in self.form], w, "DETAILS")
        if self.log:
            rows = []
            for state, label, detail in self.log:
                mark = {"ok": GREEN("✔"), "fail": RED("✘")}.get(state, ORANGE(state))
                gap = w - 8 - len(label) - (len(detail) + 1 if detail else 0)
                rows.append(f"{mark} {label}{FAINT(' ' + '·' * max(1, gap - 1))}" + (f" {GREY(detail)}" if detail else ""))
            out += box(rows, w, "PROGRESS")
        return out

    def hints(self, text):
        return ["", FAINT(text)]

    def field_box(self, label, value, secret=False, state="edit", note=""):
        """A one-line input box. state: edit, check (spinner), ok, bad."""
        width = min(48, screen_width())
        room = width - 10
        if state == "ok":
            line, edge = GREEN("✔  access granted"), GREEN
        elif state == "check":
            line, edge = ORANGE(SPIN[int(time.time() * FPS) % len(SPIN)]) + GREY("  checking…"), ORANGE
        else:
            shown = "•" * len(value) if secret else value
            shown = shown[-room:]
            cursor = ORANGE("▏") if int(time.time() * 2) % 2 == 0 else " "
            line = f"{ORANGE('❯')} {shown}{cursor}" if value else f"{ORANGE('❯')} {cursor}{FAINT(note)}"
            edge = RED if state == "bad" else FAINT
        return box([line], width, label, edge=edge)

    # ── widgets ──

    def text_field(self, label, default="", secret=False, hint="enter  ·  esc back", message="", above=None):
        """An animated input box. Returns the text, raises Cancel on Esc."""
        if not TTY:
            prompt = f"  ❯ {label}" + (f" [{default}]" if default else "") + ": "
            return (getpass.getpass(prompt) if secret else input(prompt)).strip() or default
        value = default
        while True:
            def build(compact):
                return (self.hero(compact) + [""] + (above() if above else [])
                        + self.field_box(label, value, secret) + ["", message] + self.hints(hint))
            self.show(build)
            key = read_key(1 / FPS)
            if key is None:
                continue
            if key == "enter":
                return value.strip()
            if key == "esc":
                raise Cancel
            if key == "backspace":
                value = value[:-1]
            elif len(key) == 1 and key.isprintable():
                value += key

    def confirm(self, question, default=True):
        if not TTY:
            answer = input(f"  ❯ {question} [{'Y/n' if default else 'y/N'}] ").strip().lower()
            return default if not answer else answer.startswith("y")
        yes = default
        while True:
            buttons = (SELECTED("  Yes  ") if yes else GREY("  Yes  ")) + "   " + (SELECTED("  No  ") if not yes else GREY("  No  "))
            self.show(lambda compact: self.hero(compact) + [""] + self.panels() + ["", BOLD(question), "", buttons]
                      + self.hints("←→ choose  ·  enter confirm  ·  esc back"))
            key = read_key(1 / FPS)
            if key is None:
                continue
            if key in ("left", "right", "tab", "h", "l"):
                yes = not yes
            elif key.lower() in ("y", "n"):
                return key.lower() == "y"
            elif key == "enter":
                return yes
            elif key == "esc":
                return False

    def task(self, label, work):
        """Run work() in the background with a spinner. work returns (ok, detail)."""
        self.log.append(("", label, ""))
        self.busy = True
        def tick(n):
            self.log[-1] = (SPIN[n % len(SPIN)], label, "")
            self.show(lambda compact: self.hero(compact) + [""] + self.panels() + self.hints("working…"))
        try:
            ok, detail = in_background(work, tick) or (False, "failed")
        finally:
            self.busy = False
        self.log[-1] = ("ok" if ok else "fail", label, detail)
        if not TTY:
            print(f"  {'✔' if ok else '✘'} {label}  {detail}")
        return ok

    # ── password gate and entrance ──

    def gate(self):
        """First screen: hero and a password box. Returns True once unlocked."""
        message = ""
        for attempt in range(5):
            password = self.text_field("PASSWORD", secret=True, message=message,
                                       hint="enter  unlock  ·  esc  quit")
            if not TTY:
                ok = self.check(password)
            else:
                found = {}
                def work():
                    found["ok"] = self.check(password)
                    return found["ok"]
                in_background(work, lambda n: self.show(
                    lambda compact: self.hero(compact) + [""] + self.field_box("PASSWORD", "", state="check")
                    + ["", ""] + self.hints("")))
                ok = found.get("ok")
            if ok:
                self.entrance()
                return True
            left = 4 - attempt
            message = RED(f"wrong password  ·  {left} {'try' if left == 1 else 'tries'} left") if left else ""
            self.shake(password)
            time.sleep(0.6 * (attempt + 1))  # each wrong guess waits longer
        self.status = RED("Too many attempts. Ask whoever runs the server for the password.")
        return False

    def check(self, password):
        try:
            self.secrets = unseal_secrets(password)
            return True
        except (ValueError, KeyError):
            return False

    def shake(self, password):
        """Wiggle the password box left and right in red."""
        if not TTY:
            print("  ✘ wrong password")
            return
        for offset in (3, -3, 2, -2, 1, -1, 0):
            field = [" " * max(0, offset * 2) + line + " " * max(0, -offset * 2) for line in
                     self.field_box("PASSWORD", password, secret=True, state="bad")]
            self.show(lambda compact: self.hero(compact) + [""] + field + ["", RED("wrong password")] + self.hints(""))
            time.sleep(0.045)

    def entrance(self):
        """Unlocked: green box, a jumping character, WELCOME typed out, then the menu slides in."""
        if not TTY:
            print("  ✔ access granted")
            return
        name = (self.saved.get("name") or "").strip()
        greeting = "W E L C O M E" + (f" ,   {spaced(name)}" if name else "")
        menu = self.menu_box()
        clock = time.time()
        while True:
            t = time.time() - clock
            if t < 0.7:      # 1. the box turns green
                body = [""] + self.field_box("PASSWORD", "", state="ok")
                top = self.hero(arms_up=True, tagline="access granted")
            elif t < 1.9:    # 2. the character jumps, arms up while in the air
                up = int(t * 7) % 2 == 0
                body = [""] + self.field_box("PASSWORD", "", state="ok")
                top = self.hero(lift=up, arms_up=up, tagline="access granted")
            elif t < 3.0:    # 3. the greeting types itself out
                shown = greeting[: int((t - 1.9) / 1.1 * len(greeting)) + 1]
                top = self.hero(title=shown + ORANGE("█"), tagline="access granted")
                body = []
            elif t < 3.8:    # 4. the menu slides in, line by line
                top = self.hero(title=greeting, tagline="access granted")
                body = [""] + menu[: int((t - 3.0) / 0.8 * len(menu)) + 1]
            else:
                break
            self.show(lambda compact, top=top, body=body: (self.hero(True, title=greeting) if compact else top) + body)
            if read_key(1 / 30) is not None:  # any key skips the show
                break

    # ── menu ──

    def menu_box(self):
        width = min(42, screen_width())
        lines = []
        for i, (label, _, _) in enumerate(self.items):
            text = f"  ❯  {label}" if i == self.selected else f"     {label}"
            lines.append(SELECTED(pad(text, width - 6)) if i == self.selected else GREY(pad(text, width - 6)))
        return box(lines, width, "MENU")

    def status_line(self):
        def mark(good, text):
            return (GREEN("✔") if good else GREY("○")) + " " + GREY(text)
        return "   ".join([mark(True, "python " + sys.version.split()[0]),
                           mark(bool(self.claude), "claude code" if self.claude else "no claude code"),
                           mark(CFG.exists(), "set up" if CFG.exists() else "not set up")])

    def choose(self):
        if not TTY:
            for i, (label, _, _) in enumerate(self.items):
                print(f"  [{'q' if label == 'Quit' else i + 1}] {label}")
            key = input("  ❯ Choose: ").strip().lower()
            if key == "q":
                return len(self.items) - 1
            return int(key) - 1 if key.isdigit() and 0 < int(key) <= len(self.items) else None
        while True:
            note = self.status or GREY(self.items[self.selected][1])
            self.show(lambda compact: self.hero(compact) + [""] + self.menu_box() + [self.status_line()]
                      + self.panels() + ["", note] + self.hints("↑↓ move  ·  enter choose  ·  q quit"))
            key = read_key(1 / FPS)
            if key is None:
                continue
            if key in ("up", "k"):
                self.selected = (self.selected - 1) % len(self.items)
            elif key in ("down", "j"):
                self.selected = (self.selected + 1) % len(self.items)
            elif key == "enter":
                return self.selected
            elif key in ("q", "esc"):
                return len(self.items) - 1
            elif key.isdigit() and 0 < int(key) <= len(self.items):
                self.selected = int(key) - 1
                return self.selected
            self.status = ""

    def loop(self):
        while True:
            choice = self.choose()
            if choice is None:
                continue
            action = self.items[choice][2]
            if action is None:
                return
            self.plan, self.form, self.log, self.status = [], [], [], ""
            try:
                action()
            except (KeyboardInterrupt, Cancel):
                self.plan, self.status = [], RED("Cancelled.")  # cancels the action, not the app

    # ── actions ──

    def install(self):
        if not self.claude:
            self.status = RED("Claude Code is not installed. Get it from https://claude.ai/code")
            return
        self.plan = [f"{ORANGE('▸')} add the ClaudeLimitBot marketplace to Claude Code",
                     f"{ORANGE('▸')} install the limit-bot plugin, a hook that runs on rate limits",
                     f"{ORANGE('▸')} save your name, email and webhook to {GREY('~/.config/limit-bot')}"]
        if not self.confirm("Install ClaudeLimitBot?"):
            self.status = GREY("Install skipped.")
            return
        self.plan = []
        name = self.text_field("DISPLAY NAME", self.saved.get("name", ""), above=self.panels)
        self.form.append(("Display name", name))
        email = self.text_field("EMAIL", self.saved.get("email", ""), above=self.panels)
        self.form.append(("Email", email))
        if not name or not email:
            self.status = RED("A name and an email are both needed.")
            return
        webhook = self.secrets.get("webhook") or self.text_field("WEBHOOK URL", self.saved.get("webhook", ""), secret=True, above=self.panels)
        if not re.match(r"https://(\w+\.)?discord(app)?\.com/api/webhooks/\d+/.+", webhook or ""):
            self.status = RED("That is not a Discord webhook URL.")
            return
        self.form.append(("Webhook", GREEN("unlocked") if self.secrets.get("webhook") else "•" * 10))
        token, discord_id = self.secrets.get("token"), None
        if token:
            username = self.text_field("DISCORD USERNAME", self.saved.get("username", ""), above=self.panels)
            found = {}
            def lookup():
                try:
                    found["m"] = find_member(token, username)
                except Exception as e:
                    return False, str(e)[:50]
                if not found["m"]:
                    return False, "not on the server"
                seats = {"premium": "Premium Seat", "standard": "Standard Seat", None: "no seat"}
                return True, f"@{found['m'][1]} · {seats[found['m'][2]]}"
            if not self.task("Finding you on Discord", lookup):
                self.status = RED(f"Couldn't find {username} on the server. Use your Discord username.")
                return
            discord_id = found["m"][0]
            self.form.append(("Discord", f"@{found['m'][1]}"))
        steps = [
            ("Adding marketplace", lambda: outcome(run([self.claude, "plugin", "marketplace", "add", REPO]))),
            ("Installing plugin", lambda: outcome(run([self.claude, "plugin", "install", f"{PLUGIN}@{MKT}"]))),
            ("Saving settings", lambda: outcome(run([sys.executable, str(NOTIFY), "setup", "--name", name,
                                                     "--email", email, "--webhook", webhook]
                                                    + (["--token", token, "--discord-id", discord_id] if token else [])),
                                                "only you can read it")),
        ]
        if all(self.task(label, work) for label, work in steps):
            self.saved = {"name": name, "email": email, "username": username if token else ""}
            self.status = GREEN("Installed. Restart Claude Code to switch it on.")
        else:
            self.status = RED("Something failed. The red line says what.")

    def update(self):
        if not self.claude:
            self.status = RED("Claude Code is not installed.")
            return
        if (HERE / ".git").exists() and shutil.which("git"):
            self.task("Updating this folder", lambda: outcome(run(["git", "-C", str(HERE), "pull", "--ff-only"])))
        if self.task("Refreshing marketplace", lambda: outcome(run([self.claude, "plugin", "marketplace", "update", MKT]))):
            if self.task("Updating plugin", lambda: outcome(run([self.claude, "plugin", "update", f"{PLUGIN}@{MKT}"]), "up to date")):
                self.status = GREEN("Updated. Restart Claude Code to use the new version.")

    def uninstall(self):
        self.plan = [f"{ORANGE('▸')} remove the limit-bot plugin and its marketplace",
                     f"{ORANGE('▸')} delete your saved settings in {GREY('~/.config/limit-bot')}"]
        if not self.confirm("Remove everything?", default=False):
            self.status = GREY("Nothing was removed.")
            return
        self.plan = []
        if self.claude:
            self.task("Removing plugin", lambda: outcome(run([self.claude, "plugin", "uninstall", f"{PLUGIN}@{MKT}"])))
            self.task("Removing marketplace", lambda: outcome(run([self.claude, "plugin", "marketplace", "remove", MKT])))
        self.task("Deleting settings", lambda: (shutil.rmtree(CFG.parent, ignore_errors=True), (True, ""))[1])
        self.status = GREEN("Removed.")


def main():
    app = App()
    restore_keys = key_mode()
    if TTY:
        sys.stdout.write("\033[?1049h\033[?25l\033[H\033[2J")  # own screen, hidden cursor
    message = GREY("  Bye.")
    try:
        if not SEALED.exists() or app.gate():
            app.loop()
        else:
            message = GREY("  Locked.")
    except (KeyboardInterrupt, EOFError, Cancel):
        message = GREY("  Bye.")  # Ctrl+C or Esc on the first screen leaves cleanly
    finally:
        restore_keys()
        if TTY:
            sys.stdout.write("\033[?25h\033[?1049l")  # always give the terminal back
            sys.stdout.flush()
    print(message)
    if app.status:
        print("  " + app.status)


